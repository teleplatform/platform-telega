<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Unique identifier for this LaunchAgent -->
    <key>Label</key>
    <string>com.telegpt.vault-bridge</string>

    <!-- Path to node executable -->
    <key>ProgramArguments</key>
    <array>
      <string>/usr/local/bin/node</string>
      <string>--import</string>
      <string>tsx</string>
      <string>/Users/vijaytaitoo/Projects/tele-gpt/src/telegram/vaultBotBridge.launch.ts</string>
    </array>

    <!-- Working directory -->
    <key>WorkingDirectory</key>
    <string>/Users/vijaytaitoo/Projects/tele-gpt</string>

    <!-- Environment variables -->
    <key>EnvironmentVariables</key>
    <dict>
      <key>NODE_ENV</key>
      <string>production</string>
      <key>VAULT_BOT_TELEGRAM_TOKEN</key>
      <string>PLACEHOLDER_REPLACE_ME</string>
      <key>VAULT_BOT_TELEGPT_URL</key>
      <string>http://localhost:8787</string>
      <key>VAULT_BOT_VAULT_URL</key>
      <string>http://localhost:8200</string>
      <key>VAULT_TOKEN</key>
      <string>PLACEHOLDER_REPLACE_ME</string>
      <key>VAULT_ENVIRONMENT</key>
      <string>production</string>
    </dict>

    <!-- Launch at login/startup -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Keep alive and restart on crash -->
    <key>KeepAlive</key>
    <dict>
      <key>SuccessfulExit</key>
      <false/>
    </dict>

    <!-- Restart on crash with delay -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- Standard output and error paths -->
    <key>StandardOutPath</key>
    <string>/tmp/telegpt-vault-bridge.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/telegpt-vault-bridge.err</string>

    <!-- Process type -->
    <key>ProcessType</key>
    <string>Interactive</string>

    <!-- Nice value (lower = higher priority) -->
    <key>Nice</key>
    <integer>5</integer>
  </dict>
</plist>
