# NOTE: This is a minimal Quick Start env. Advanced / maker-only configs live elsewhere.
# =========================================================
# Tele•GPT — Minimal .env.example (Quick Start)
# =========================================================

# -------------------------
# Core
# -------------------------
PORT=8787
TELEGPT_PORT=8787
TELEGPT_HOST=0.0.0.0
TELEGPT_ENV=dev
TELEGPT_MAX_CONCURRENCY=4
TELEGPT_MAX_QUEUE=50
TELEGPT_REQUEST_TIMEOUT_MS=15000

# -------------------------
# Storage
# -------------------------
TELEGPT_DB_PATH=./.data/tele-gpt.sqlite
TELEGPT_KNOWLEDGE_PATH=./data/demo-knowledge.json

# -------------------------
# Telegram
# -------------------------
TELEGRAM_BOT_TOKEN=PASTE_TOKEN_HERE

# -------------------------
# Providers (choose one)
# -------------------------
OPENAI_API_KEY=
LOCAL_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_OPENAI_MODEL=deepseek-r1:1.5b

# -------------------------
# Pack v1.4: Policy/Quota/RateLimit
# -------------------------
TELEGPT_GATE_ENABLED=1

# Optional Redis (recommended). If empty -> memory fallback.
TELEGPT_REDIS_URL=redis://localhost:6379

# Identity
TELEGPT_CLIENT_ID_HEADER=x-telegpt-client-id

# Rate limits (per identity)
TELEGPT_RL_CHAT_PER_MIN=20
TELEGPT_RL_MODELS_PER_MIN=60

# Daily quota "units" (simple proxy for cost)
# Default: 200 requests/day. (потом заменим на token-based)
TELEGPT_QUOTA_REQ_PER_DAY=200

# Policy: allow model prefixes (comma list)
# Example: "openai:gpt-4o-mini,openai:*,local:*"
TELEGPT_POLICY_ALLOW_MODELS=openai:*,local:*,deepseek:*,qwen:*,moonshotai/*,qwen2.5:*,openai_web:*,qwen_web:*,deepseek_web:*,kimi_web:*

# -------------------------
# Longform Engine v3.2
# -------------------------
LONGFORM_MODEL=qwen2.5:3b-instruct
LONGFORM_TIMEOUT_MS=120000
LONGFORM_NUM_PREDICT=3500
LONGFORM_TEMPERATURE=0.7
LONGFORM_RETRY_TEMPERATURE=0.85
LONGFORM_CHUNK_WORDS=350
LONGFORM_CHUNK_TIMEOUT_MS=90000
