# -------------------------------------------------------------------
# .env.example = шаблон переменных окружения (БЕЗ секретов)
# Не коммитим реальные ключи в репозиторий — они живут только в .env
# -------------------------------------------------------------------

# Idempotency (dev-safe, in-memory)
IDEMPO_LOG_EVERY=200
IDEMPO_TTL_INFLIGHT_MS=60000
IDEMPO_TTL_DONE_MS=86400000
IDEMPO_MAX_ENTRIES=5000

# Runtime
TELEGPT_ENV=dev
TELEGPT_HOST=0.0.0.0
TELEGPT_PORT=8787
# Compatibility (some PaaS use PORT)
PORT=8787
TELEGPT_MAX_CONCURRENCY=4
TELEGPT_MAX_QUEUE=50
TELEGPT_SHUTDOWN_TIMEOUT_MS=15000
# Runtime mode
TELEGA_MODE=creator # public|creator|core

# OpenAI (leave empty; set in real .env)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Local OpenAI-compatible (vLLM / Ollama / llama.cpp server)
LOCAL_OPENAI_BASE_URL=http://127.0.0.1:8317/v1
LOCAL_OPENAI_MODEL=gpt-5.2
LOCAL_OPENAI_API_KEY=
# Example vLLM:
# LOCAL_OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# LOCAL_OPENAI_MODEL=Qwen/Qwen3-4B-Instruct-2507

# Runtime safety
TELEGPT_REQUEST_TIMEOUT_MS=15000
TELEGPT_BODY_LIMIT=1048576
TELEGPT_TRUST_PROXY=0

# Storage
TELEGPT_STORAGE=sqlite
TELEGPT_DATA_DIR=.data

# Build / deploy metadata
TELEGPT_BUILD_ID=dev
TELEGPT_GIT_SHA=
