# ===========================
# Tele•GPT — MAIN ENV (CANON)
# ===========================
TELEGPT_PORT=8787
TELEGPT_ENV=main

# --- default provider
TELEGPT_PROVIDER_DEFAULT=local

# --- local OpenAI-compatible endpoint
LOCAL_OPENAI_BASE_URL=http://localhost:11434
LOCAL_OPENAI_API_KEY=local-main-key
LOCAL_OPENAI_MODEL_DEFAULT=qwen2.5:7b-instruct

# --- hard-proof flags
TRACES_FORCE_PROVIDER=true

# --- cloud keys (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=PASTE_ANTHROPIC_KEY_HERE
XAI_API_KEY=PASTE_XAI_KEY_HERE
OPENROUTER_API_KEY=PASTE_OPENROUTER_KEY_HERE
DASHSCOPE_API_KEY=
GLM_API_KEY=PASTE_GLM_KEY_HERE

# Qwen fallback via OpenRouter (only for Qwen)
OPENROUTER_QWEN_MODEL=qwen/qwen-2.5-72b-instruct

# ==========================================
# Providers Pack v1 (Tele•GPT / Sigma Forge)
# ==========================================

# --- MiMo (Xiaomi)
MIMO_API_KEY=PASTE_MIMO_KEY_HERE
MIMO_API_BASE_URL=
MIMO_MODEL=mimo-v2-flash

# --- LTX-2 (Lightricks)
LTX_API_KEY=PASTE_LTX_KEY_HERE
LTX_API_BASE_URL=
LTX_PROFILE_DEFAULT=ltx-2-fast

# --- Seedance (Bridge) — OFF by default
SEEDANCE_API_KEY=PASTE_SEEDANCE_KEY_HERE
SEEDANCE_API_BASE_URL=
SEEDANCE_ENABLED=0

# ==========================================
# Providers Pack v1 — Gemini + TranslateGemma
# ==========================================

# Google Gemini (optional)
GEMINI_API_KEY=AIzaSyC_nwUtlPzCKx2v3qf_JUzrnHc1UIhap0o
GEMINI_MODEL_DEFAULT=gemini-2.0-flash

# Translate engine (local default)
TRANSLATE_MODEL_PROVIDER=local
TRANSLATE_MODEL_LOCAL_SMALL=translategemma_4b
TRANSLATE_MODEL_LOCAL_LARGE=TranslateGemma_12B
TRANSLATE_MODEL_LOCAL_NAME=translategemma_4b
# Pantheon Intel
TELEGA_ROOT=/Users/vijaytaitoo/tele-ga
PANTHEON_INTEL_ENABLED=1
PANTHEON_INTEL_CHAT_IDS=

# Telegram Bot
TELEGRAM_BOT_TOKEN=PASTE_TOKEN_HERE
PANTHEON_TG_POLLING=1

# Pantheon BuildTask Worker (Maker-gated)
PANTHEON_MAKER_IDS=
