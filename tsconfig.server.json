{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": true,
    "target": "ES2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "#i18n/messages": ["src/i18n/messages.ts"],
      "#i18n/keypath-runtime": ["src/i18n/messages.keypath.runtime.ts"]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/server/index.ts",
    "src/channels/**/*.ts",
    "src/runtime/**/*.ts",
    "src/core/**/*.ts"
  ],
  "exclude": [
    "src/server/routes/*.ts",
    "src/telegram/**/*.ts"
  ]
}