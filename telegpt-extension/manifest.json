{
  "manifest_version": 3,
  "name": "TeleGPT Creator Bridge",
  "version": "1.0.0",
  "permissions": ["scripting", "activeTab"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://chat.qwen.ai/*",
    "https://chat.deepseek.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://chat.qwen.ai/*",
        "https://chat.deepseek.com/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}